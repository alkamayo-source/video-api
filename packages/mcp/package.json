{
  "name": "@multiful/video-api-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Multiful Video API — Cursor / Claude Desktop / autonomous agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "video-api-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@multiful/video-api-sdk": "^0.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "ai",
    "agent",
    "cursor",
    "claude-desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkamayo-source/video-api.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/alkamayo-source/video-api#readme",
  "bugs": {
    "url": "https://github.com/alkamayo-source/video-api/issues"
  }
