{
  "name": "@multiful/video-api-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Multiful Video API — autonomous-agent friendly",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen:types": "openapi-typescript ../../openapi.yaml --default-non-nullable false -o src/generated/schema.ts",
    "build": "npm run gen:types && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "msw": "^2.6.0",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "video",
    "ai",
    "api",
    "sdk",
    "agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alkamayo-source/video-api.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/alkamayo-source/video-api#readme",
  "bugs": {
    "url": "https://github.com/alkamayo-source/video-api/issues"
  }
}
